# LeaseMind app-foundation API — synthetic development only.
# Do not put real credentials, real personal data or production endpoints here.
HOST=127.0.0.1
PORT=3001
NODE_ENV=development

# Least-privilege database boundary (see
# 03_ARCHITECTURE/decisions/ADR-0005-least-privilege-database-boundary.md,
# ADR-0007-synthetic-campaign-creation-command-boundary.md and
# ADR-0008-technical-assignment-implementation.md,
# ADR-0009-analysis-snapshot-implementation.md and
# ADR-0010-campaign-outcome-implementation.md).
# Ten distinct connections, nine application LOGIN roles plus one
# bootstrap/admin identity -- never interchangeable:

# API runtime only (server.ts). SELECT-only on campaign_current_state_projection.
DATABASE_URL=postgres://lmapp_api_reader:synthetic-api-reader-only-password@127.0.0.1:5433/lmapp_dev

# migrate-cli.ts only. Owns leasemind_app schema and the migration ledger.
LEASEMIND_MIGRATION_DATABASE_URL=postgres://lmapp_migrator:synthetic-migrator-only-password@127.0.0.1:5433/lmapp_dev

# seed-cli.ts (and any future rebuild CLI) only. Append + rebuild, no DDL.
LEASEMIND_MAINTENANCE_DATABASE_URL=postgres://lmapp_maintainer:synthetic-maintainer-only-password@127.0.0.1:5433/lmapp_dev

# server.ts's Campaign creation command path only (POST /api/v1/campaigns).
# Same shape of grants as the maintainer above, but a separate role/credential
# dedicated to the HTTP runtime -- never migrator/maintainer/bootstrap.
LEASEMIND_COMMAND_DATABASE_URL=postgres://lmapp_campaign_writer:synthetic-campaign-writer-only-password@127.0.0.1:5433/lmapp_dev

# server.ts's Technical Assignment draft-save command path only
# (POST /api/v1/technical-assignments). The only role with any access to
# the protected address table (ADR-0008).
LEASEMIND_TECHNICAL_ASSIGNMENT_DATABASE_URL=postgres://lmapp_ta_writer:synthetic-ta-writer-only-password@127.0.0.1:5433/lmapp_dev

# server.ts's synchronous Analysis command path only. Never worker/CLI.
LEASEMIND_ANALYSIS_DATABASE_URL=postgres://lmapp_analysis_writer:synthetic-analysis-writer-only-password@127.0.0.1:5433/lmapp_dev

# Separate post-launch-refresh worker process only. Never server.ts.
LEASEMIND_ANALYSIS_WORKER_DATABASE_URL=postgres://lmapp_analysis_worker:synthetic-analysis-worker-only-password@127.0.0.1:5433/lmapp_dev

# Operational evidence-revocation CLI only. Never server.ts/worker.ts.
LEASEMIND_EVIDENCE_REVOCATION_DATABASE_URL=postgres://lmapp_evidence_revocation_writer:synthetic-evidence-revocation-writer-only-password@127.0.0.1:5433/lmapp_dev

# Campaign Outcome operational CLI only (ADR-0010) -- not yet implemented as
# of the database-foundation block; reserved so the connection identity
# contract is complete. Never server.ts/worker.ts.
LEASEMIND_CAMPAIGN_OUTCOME_DATABASE_URL=postgres://lmapp_campaign_outcome_writer:synthetic-campaign-outcome-writer-only-password@127.0.0.1:5433/lmapp_dev

# Bootstrap/admin connection: used only by `npm run provision-roles` and
# test infrastructure. Never read by server.ts, migrate-cli.ts or seed-cli.ts.
LEASEMIND_BOOTSTRAP_DATABASE_URL=postgres://lmapp_dev:synthetic-dev-only-password@127.0.0.1:5433/lmapp_dev

# Passwords used only by `npm run provision-roles` (apps/api/src/db/provision-roles-cli.ts)
# to create/reset the nine LOGIN roles above and the passwordless NOLOGIN
# post-launch-refresh owner role. Synthetic values only.
LEASEMIND_MIGRATOR_PASSWORD=synthetic-migrator-only-password
LEASEMIND_MAINTAINER_PASSWORD=synthetic-maintainer-only-password
LEASEMIND_API_READER_PASSWORD=synthetic-api-reader-only-password
LEASEMIND_CAMPAIGN_WRITER_PASSWORD=synthetic-campaign-writer-only-password
LEASEMIND_TA_WRITER_PASSWORD=synthetic-ta-writer-only-password
LEASEMIND_ANALYSIS_WRITER_PASSWORD=synthetic-analysis-writer-only-password
LEASEMIND_ANALYSIS_WORKER_PASSWORD=synthetic-analysis-worker-only-password
LEASEMIND_EVIDENCE_REVOCATION_WRITER_PASSWORD=synthetic-evidence-revocation-writer-only-password
LEASEMIND_CAMPAIGN_OUTCOME_WRITER_PASSWORD=synthetic-campaign-outcome-writer-only-password

# Pre-launch runtime safety gate (see
# 03_ARCHITECTURE/decisions/ADR-0003-pre-launch-runtime-safety-gate.md).
# These are the only values the server accepts before a separate
# PRODUCTION_LAUNCH_GATE decision; leaving them unset is equally safe, since
# the server defaults to exactly these values when a variable is absent.
LEASEMIND_RUNTIME_MODE=synthetic
LEASEMIND_PRODUCTION_LAUNCH_GATE=blocked
LEASEMIND_ALLOW_REAL_PII=false
LEASEMIND_ALLOW_REAL_PAYMENTS=false
LEASEMIND_ALLOW_PROTECTED_REVEAL=false
LEASEMIND_ALLOW_PRODUCTION_ADAPTERS=false

# LeaseMind app-foundation API — synthetic development only.
# Do not put real credentials, real personal data or production endpoints here.
HOST=127.0.0.1
PORT=3001
NODE_ENV=development

# Least-privilege database boundary (see
# 03_ARCHITECTURE/decisions/ADR-0005-least-privilege-database-boundary.md).
# Four distinct connections, four distinct roles -- never interchangeable:

# API runtime only (server.ts). SELECT-only on campaign_current_state_projection.
DATABASE_URL=postgres://lmapp_api_reader:synthetic-api-reader-only-password@127.0.0.1:5433/lmapp_dev

# migrate-cli.ts only. Owns leasemind_app schema and the migration ledger.
LEASEMIND_MIGRATION_DATABASE_URL=postgres://lmapp_migrator:synthetic-migrator-only-password@127.0.0.1:5433/lmapp_dev

# seed-cli.ts (and any future rebuild CLI) only. Append + rebuild, no DDL.
LEASEMIND_MAINTENANCE_DATABASE_URL=postgres://lmapp_maintainer:synthetic-maintainer-only-password@127.0.0.1:5433/lmapp_dev

# Bootstrap/admin connection: used only by `npm run provision-roles` and
# test infrastructure. Never read by server.ts, migrate-cli.ts or seed-cli.ts.
LEASEMIND_BOOTSTRAP_DATABASE_URL=postgres://lmapp_dev:synthetic-dev-only-password@127.0.0.1:5433/lmapp_dev

# Passwords used only by `npm run provision-roles` (apps/api/src/db/provision-roles-cli.ts)
# to create/reset the three roles above. Synthetic values only.
LEASEMIND_MIGRATOR_PASSWORD=synthetic-migrator-only-password
LEASEMIND_MAINTAINER_PASSWORD=synthetic-maintainer-only-password
LEASEMIND_API_READER_PASSWORD=synthetic-api-reader-only-password

# Pre-launch runtime safety gate (see
# 03_ARCHITECTURE/decisions/ADR-0003-pre-launch-runtime-safety-gate.md).
# These are the only values the server accepts before a separate
# PRODUCTION_LAUNCH_GATE decision; leaving them unset is equally safe, since
# the server defaults to exactly these values when a variable is absent.
LEASEMIND_RUNTIME_MODE=synthetic
LEASEMIND_PRODUCTION_LAUNCH_GATE=blocked
LEASEMIND_ALLOW_REAL_PII=false
LEASEMIND_ALLOW_REAL_PAYMENTS=false
LEASEMIND_ALLOW_PROTECTED_REVEAL=false
LEASEMIND_ALLOW_PRODUCTION_ADAPTERS=false

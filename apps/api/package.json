{
  "name": "@leasemind/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "dev:analysis-worker": "node --env-file-if-exists=.env --import tsx src/analysis-worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "start:analysis-worker": "node dist/src/analysis-worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "provision-roles": "node --env-file-if-exists=.env --import tsx src/db/provision-roles-cli.ts",
    "migrate:up": "node --env-file-if-exists=.env --import tsx src/db/migrate-cli.ts up",
    "migrate:down": "node --env-file-if-exists=.env --import tsx src/db/migrate-cli.ts down",
    "seed": "node --env-file-if-exists=.env --import tsx src/db/seed-cli.ts",
    "revoke-evidence-dataset": "node --env-file-if-exists=.env --import tsx src/db/revoke-evidence-dataset-cli.ts",
    "campaign-outcome": "node --env-file-if-exists=.env --import tsx src/db/campaign-outcome-cli.ts",
    "campaign-outcome-rebuild": "node --env-file-if-exists=.env --import tsx src/db/campaign-outcome-rebuild-cli.ts"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}

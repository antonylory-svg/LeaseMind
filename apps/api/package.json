{
  "name": "@leasemind/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "migrate:up": "node --env-file-if-exists=.env --import tsx src/db/migrate-cli.ts up",
    "migrate:down": "node --env-file-if-exists=.env --import tsx src/db/migrate-cli.ts down",
    "seed": "node --env-file-if-exists=.env --import tsx src/db/seed-cli.ts"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
